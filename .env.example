# Copy to .env.local for `pnpm dev`. All values are server-side only; never
# prefix any of them with NEXT_PUBLIC_. Tests and `pnpm eval` need none of them.

# --- Database (Neon Postgres, EU region, with the pgvector extension) ---
# DATABASE_URL: pooled connection string (host contains -pooler), used by the app.
# DIRECT_URL:   direct connection string, used by `pnpm db:migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/DB?sslmode=require"

# --- Auth.js (Google) ---
# AUTH_SECRET: generate with `openssl rand -base64 33`.
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback/google (and http://localhost:3000/... for dev)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- LLM gateway (lib/llm) ---
# LLM_PROVIDER: "openai" (default) or "mock" (returns an empty draft; no key needed).
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
# Model per purpose. Defaults: extract = gpt-5.4, everything else = gpt-5.4-mini.
LLM_MODEL_EXTRACT=""
LLM_MODEL_DEFAULT=""
# Prices in USD per million tokens for the models above, used to store cost per
# call. Leave empty to store cost as null. Take them from the provider's price page.
LLM_PRICE_INPUT_PER_MTOK_USD=""
LLM_PRICE_OUTPUT_PER_MTOK_USD=""
