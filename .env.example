# Copy the runtime vars into .env.local, and the database URLs into BOTH
# .env.local (Next runtime) and .env (read by the Prisma CLI for migrations).
# Everything here is server-side only — never prefix with NEXT_PUBLIC_.

# --- OpenAI ---
OPENAI_API_KEY="sk-..."

# --- Neon Postgres ---
# DATABASE_URL: pooled connection (…-pooler.…), used by the app at runtime.
# DIRECT_URL:   direct connection (no -pooler), used by `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# --- Auth.js (Google OAuth) ---
# AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 33`).
# Google credentials come from Google Cloud Console → Credentials → OAuth client.
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://YOUR-DOMAIN/api/auth/callback/google
AUTH_SECRET="..."
AUTH_GOOGLE_ID="....apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="..."
